{
  "name": "service-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Service Desk ITIL v4 - monorepo (API NestJS + Web React)",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @servicedesk/api start:dev",
    "dev:web": "pnpm --filter @servicedesk/web dev",
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @servicedesk/api test:e2e",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "prisma:generate": "pnpm --filter @servicedesk/api prisma:generate",
    "prisma:migrate": "pnpm --filter @servicedesk/api prisma:migrate",
    "prisma:seed": "pnpm --filter @servicedesk/api prisma:seed"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6"
  }
}
