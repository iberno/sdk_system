# ============================================================
# Ambiente de Desenvolvimento - Service Desk
# Copie para .env e ajuste os valores (NUNCA comite o .env)
# ============================================================

# PostgreSQL - configure a string de conexao no seu .env local
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/servicedesk?schema=public"

# API
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="troque_esta_chave_access_dev"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque_esta_chave_refresh_dev"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
VITE_API_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"

# Multi-empresa (default 1 - empresa raiz)
DEFAULT_COMPANY_ID="00000000-0000-0000-0000-000000000001"